{
  "expo": {
    "name": "BookRoutine_app",
    "slug": "bookroutine",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "bookroutineapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "독서 중 집중도를 측정하기 위해 카메라를 사용해요. 영상은 기기 밖으로 전송되지 않아요."
      }
    },
    "android": {
      "package": "com.bookroutine.app",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": ["android.permission.CAMERA"]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-notifications",
      [
        "expo-media-library",
        {
          "photosPermission": "문장 이미지를 만들 때 배경 사진을 고르기 위해 사진 접근 권한이 필요해요.",
          "savePhotosPermission": "만든 문장 이미지를 갤러리에 저장하기 위해 권한이 필요해요.",
          "isAccessMediaLocationEnabled": false
        }
      ],
      "react-native-fast-tflite",
      ["expo-build-properties", { "android": { "minSdkVersion": 26 } }]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "a9aea19d-8289-4697-89d8-c2579f05a852"
      }
    },
    "owner": "hyongs-team"
  }
}
